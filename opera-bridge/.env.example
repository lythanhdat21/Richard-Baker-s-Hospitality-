# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Internal API key
INTERNAL_API_KEY=change-me-in-production

# Database
DATABASE_URL=postgresql://opera_user:opera_pass@localhost:5432/opera_bridge

# OPERA Cloud credentials
OPERA_CLIENT_ID=your-client-id
OPERA_CLIENT_SECRET=your-client-secret
OPERA_BASE_URL=https://your-opera-cloud-url.com
OPERA_HOTEL_ID=your-hotel-id

# Token cache TTL seconds
OPERA_TOKEN_TTL=3300

# MQTT Broker
MQTT_HOST=mqtt
MQTT_PORT=1883
MQTT_CLIENT_ID=opera-bridge

# Đồng bộ định kỳ trạng thái phòng (giây)
ROOM_STATUS_SYNC_INTERVAL_SECONDS=300
